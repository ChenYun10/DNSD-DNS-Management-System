# ============================================================================
# dns-platform 环境配置模板
# 复制为 .env 并填入真实值。切勿将真实密钥提交到版本库。
# 生成密钥示例： openssl rand -hex 32
# ============================================================================

# 环境: dev | prod（prod 禁止 memory 缓存 / stdout 日志）
ENV=dev
LOG_LEVEL=info
INSTANCE_ID=inst-1

# 平台公共域名（DoT/DoH 前缀的基域，需要 *.BASE_DOMAIN 泛域名证书）
BASE_DOMAIN=dns.example.com

# 下行监听（客户端面）
DNS_LISTEN_UDP=:53
DNS_LISTEN_TCP=:53
DOT_LISTEN=:853
DOH_LISTEN=:8443
DOQ_LISTEN=:784

# 内网专用监听（面向内网 IPv6 接入客户端，与公网监听隔离；空=禁用）
# 该监听上的 IPv6 客户端会触发「IPv6→真实IPv4→ECS透传」推导
INT_LISTEN_UDP=
INT_LISTEN_TCP=

# TLS 证书（泛域名证书 *.BASE_DOMAIN，DoT/DoH/DoQ 共用）
TLS_CERT_FILE=./certs/fullchain.pem
TLS_KEY_FILE=./certs/privkey.pem

# 上游默认
DEFAULT_UPSTREAM_GROUP=default
UPSTREAM_TIMEOUT=4s
HEALTH_INTERVAL=30s
HEALTH_DOMAIN=health-check.example.com
HEALTH_FAILS_TO_DOWN=3

# 缓存（生产必须 redis）
CACHE_DRIVER=redis
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0
CACHE_MAX_TTL=6h
NEG_CACHE_TTL=30s
WARM_THRESHOLD=60s

# 日志（生产必须 mysql）
LOG_DRIVER=mysql
MYSQL_DSN=dns:dns_pass@tcp(127.0.0.1:3306)/dns_platform?parseTime=true&charset=utf8mb4
LOG_BATCH_SIZE=500
LOG_FLUSH_INTERVAL=2s

# 查询日志查询性能（防百万级日志扫全库/深分页）
LOG_QUERY_DEFAULT_WINDOW=24h   # from/to 为空时默认查最近多久
LOG_QUERY_MAX_WINDOW=168h      # 单次查询时间跨度上限，0=不限
LOG_QUERY_MAX_OFFSET=100000    # OFFSET 上限
LOG_QUERY_COUNT_CAP=100000     # COUNT(*) 封顶（超限按封顶返回）

# DNSSEC: passthrough | ad-only | verify
DNSSEC_MODE=ad-only
DNSSEC_REQUIRE_AD=true

# ECS (EDNS Client Subnet)
ECS_PASSTHROUGH=true
ECS_SCOPE_MAX=24

# ============ IPv6→IPv4 双栈映射 + ECS 透传 ============
# 总开关：内网监听上的 IPv6 客户端，推导真实 IPv4 并经校验后透传为 ECS
DUALSTACK_ENABLED=false
# RFC6052 NAT64 前缀（逗号分隔），用于从 IPv6 内嵌提取 IPv4；IPv4-mapped(::ffff:) 始终支持
NAT64_PREFIXES=64:ff9b::/96
# 绑定表文件：CSV 每行 "ipv6_subnet,ipv4[,isp[,region]]"（# 注释）
IPV6_IPV4_MAP_FILE=
# 外部映射 API：URL 中用 {ip} 占位 IPv6；返回 JSON {"ipv4":"x.x.x.x"} 或纯文本
IPV6_IPV4_MAP_API_URL=
IPV6_IPV4_MAP_API_TIMEOUT=500ms
# 推导出的 IPv4 ECS 前缀长度（32=精确到单 IP，24=按 /24 子网）
ECS_DERIVE_MASK=32

# ============ 归属地/运营商一致性校验（纯真 IP 库，fail-closed）============
# IPv4 库：纯真 qqwry.dat；IPv6 库：CSV "ipv6_subnet,country,province,city,isp"
# 二者都配置才会校验；校验失败或未配置 → 不携带 ECS，按无 ECS 转发
GEO_IPV4_FILE=
GEO_IPV6_FILE=
# true=额外要求城市一致；false=省+运营商一致即可
GEO_STRICT_CITY=false

# 限流
RATE_LIMIT_QPS=100
RATE_LIMIT_VIP_MULT=10
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW=10m
# 是否信任反向代理注入的 X-Real-IP（仅当部署在可信反代之后且代理会覆盖该头才设为 true；
# 直连暴露时保持 false，避免伪造来源 IP 绕过登录/接口限流与审计）
TRUST_PROXY_HEADERS=false

# REST API（前后端隔离：客户 API 与管理通道分离）
API_LISTEN=:8080
API_ADMIN_LISTEN=:8443
# 管理通道 mTLS（政企专用）：填写 CA 证书路径即启用客户端证书校验
API_MTLS_CA_FILE=
API_JWT_SECRET=CHANGE_ME_TO_A_RANDOM_64_HEX_STRING
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=168h
API_CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081

# 预热
WARMUP_CONCURRENCY=32

# 首次部署：一次性管理员引导令牌（bootstrap 完成后建议删除该行）
BOOTSTRAP_TOKEN=CHANGE_ME_BOOTSTRAP

# ============ 等保安全告警 (三员分立/异常登录实时通知) ============
# 钉钉/企微 webhook; 空=禁用。钉钉加签需同时配 SECURITY_ALERT_TOKEN
SECURITY_ALERT_WEBHOOK=
SECURITY_ALERT_TOKEN=
SECURITY_ALERT_MIN_FAILS=5
SECURITY_ALERT_COOLDOWN=15m
