# 控制面镜像（REST API + 管理通道）
FROM golang:1.26-alpine AS build
WORKDIR /src
ENV GOPROXY=https://goproxy.cn,direct
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/apid ./cmd/apid

FROM alpine:3.20
RUN apk add --no-cache ca-certificates tzdata
COPY --from=build /out/apid /usr/local/bin/apid
EXPOSE 8080/tcp 8443/tcp
ENTRYPOINT ["apid", "-env", "/app/.env"]
