# ============================================================================
# 集群版环境变量模板 — 复制为 .env.cluster 并填写真实值
# 生成密钥: openssl rand -hex 32
# ============================================================================

# 平台公共域名(DoT/DoH 前缀的基底,需 *.BASE_DOMAIN 通配符证书)
BASE_DOMAIN=dns.example.com

# MySQL
MYSQL_ROOT_PASSWORD=CHANGE_ME_root
MYSQL_PASSWORD=CHANGE_ME_dns

# Redis
REDIS_PASSWORD=CHANGE_ME_redis

# 控制面
JWT_SECRET=CHANGE_ME_32_hex_bytes

# ACME(客户自定义主域名 SSL,可选)
ACME_ENABLED=false
ACME_EMAIL=
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=

# DNS 行为
DNSSEC_MODE=ad-only
ECSPASSTHROUGH=true
RATE_LIMIT_QPS=200

# 证书目录(相对 compose 文件,所有实例共享)
# 生产建议:用 NFS / rsync 同步;或用 apid 签发后同步到各节点
