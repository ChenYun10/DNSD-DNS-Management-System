# dns-platform 数据面 systemd 模板(裸机多实例)
# 用法:
#   cp /etc/dns-platform/dnsd-1.env /etc/dns-platform/dnsd-2.env   # 每实例一个 env
#   每个 env 里 INSTANCE_ID=inst-1 / inst-2
#   systemctl enable --now dnsd@1 dnsd@2
#
# 同机多实例依赖 SO_REUSEPORT(dnsd 已内置 ReusePort=true),UDP/TCP 53、853、
# 443、784 可同时绑定。

[Unit]
Description=dns-platform DNS data plane (instance %i)
After=network-online.target redis.service mysql.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/dnsd -env /etc/dns-platform/dnsd-%i.env
Restart=always
RestartSec=3
LimitNOFILE=1048576
# 高并发建议:增大 UDP 缓冲区
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/etc/dns-platform /var/lib/dns-platform
PrivateTmp=true

[Install]
WantedBy=multi-user.target
