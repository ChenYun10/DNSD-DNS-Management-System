# ============================================================================
# 生产 nginx 示例：DoH(443) 反向代理 + 前端托管
# 说明：
#   - DoT(853)/DoQ(784)/UDP(53) 由 dnsd 直接监听（DoT 按 SNI 前缀路由租户）
#   - DoH 443 由 nginx 终结 TLS，/dns-query 反代到 dnsd:8443
#   - 每个租户前缀映射到独立 upstream，便于按前缀做 WAF/限流/计量
#   - X-Real-IP 必须设置，dnsd 据此记录真实客户端 IP
# ============================================================================

# ---------- HTTP 层：前端 + DoH ----------
server {
    listen 443 ssl;
    http2 on;
    server_name dns.example.com *.dns.example.com;

    ssl_certificate     /etc/letsencrypt/live/dns.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/dns.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_prefer_server_ciphers off;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;

    # DoH (RFC 8484) — 全部前缀共用后端，dnsd 内部按 Host 前缀路由租户
    location /dns-query {
        proxy_pass http://127.0.0.1:8443;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 10s;
        proxy_buffering off;
        client_max_body_size 64k;
    }

    # 前端控制台（仅托管静态文件；管理操作走 API）
    location / {
        root /var/www/dns-platform/frontend;
        try_files $uri $uri/ /index.html;
        add_header Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; connect-src https://dns.example.com; frame-ancestors 'none'";
    }
}

# ---------- 管理 API 走独立端口（8080/8443），默认不对外 ----------
# 生产建议：API 仅监听内网/专线，或通过本 server 块的受限路径暴露
# location /api/ { proxy_pass http://127.0.0.1:8080; ... }
