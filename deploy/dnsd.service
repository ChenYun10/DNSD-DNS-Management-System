# DNS 数据面 systemd 单元（Linux）
# 安装: make build-linux && sudo make install
# 说明: 53/853/443/784 为特权端口，需 CAP_NET_BIND_SERVICE（已内置，无需 root 运行）
[Unit]
Description=dns-platform data plane (UDP/TCP/DoT/DoH/DoQ)
Documentation=https://github.com/openclaw/dns-platform
After=network-online.target redis-server.service mysql.service
Wants=network-online.target

[Service]
Type=simple
User=dns
Group=dns
# 特权端口绑定能力（53/853），最小权限
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/etc/dns-platform
# 数据面不写文件系统，仅读配置/证书
ExecStart=/usr/local/bin/dnsd -env /etc/dns-platform/.env
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=3
LimitNOFILE=1048576

[Install]
WantedBy=multi-user.target
