# DNS 数据面镜像（无前端、无管理端）
FROM golang:1.26-alpine AS build
WORKDIR /src
ENV GOPROXY=https://goproxy.cn,direct
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/dnsd ./cmd/dnsd

FROM alpine:3.20
RUN apk add --no-cache ca-certificates tzdata
COPY --from=build /out/dnsd /usr/local/bin/dnsd
EXPOSE 53/udp 53/tcp 853/tcp 8443/tcp 784/udp
ENTRYPOINT ["dnsd", "-env", "/app/.env"]
